%rec: Comment
%doc: A note on an item, by an agent or George. Append-only.
%mandatory: Item Author At Text
%allowed: Item Author At Text
%unique: Item Author At Text
%typedef: Slug_t regexp /^[a-z0-9]+(-[a-z0-9]+)*$/
%typedef: Agent_t regexp #^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(/[A-Za-z0-9._-]+)?$#
%typedef: Stamp_t regexp /^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$/
%type: Item Slug_t
%type: Author Agent_t
%type: At Stamp_t
