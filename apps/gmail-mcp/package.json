{
  "name": "@george43g/gmail-mcp",
  "version": "2.0.0",
  "private": true,
  "description": "Gmail MCP server with CLI, TUI, console, OAuth, and multi-account support",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "gmail": "./dist/cli/index.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/cli/index.js",
    "dev": "node --import tsx --env-file-if-exists=.env --env-file-if-exists=.env.local src/cli/index.ts",
    "dev:mcp": "node --import tsx --env-file-if-exists=.env --env-file-if-exists=.env.local src/cli/index.ts mcp",
    "dev:tui": "node --import tsx --env-file-if-exists=.env --env-file-if-exists=.env.local src/cli/index.ts tui",
    "dev:console": "node --import tsx --env-file-if-exists=.env --env-file-if-exists=.env.local src/cli/index.ts console",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest --config tests/e2e/vitest.config.ts run",
    "stress": "node --import tsx scripts/stress-mcp.ts",
    "gen-usage": "node --import tsx scripts/gen-usage.ts",
    "screenshots": "fc-list | grep -qi 'jetbrains mono' || { echo 'Install: brew install --cask font-jetbrains-mono'; exit 1; }; pnpm build && bash scripts/screenshots/prepare-fake-editor.sh && for f in scripts/screenshots/*.tape; do echo \"▶ $f\"; vhs \"$f\"; done",
    "screenshots:check": "pnpm screenshots && bash scripts/screenshots/check-drift.sh",
    "audit:prod": "pnpm audit --prod",
    "package:check": "npm run build && node --import tsx scripts/check-package.ts",
    "package:tarball": "npm run build && node --import tsx scripts/check-package.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run gen-usage -- --check && npm run package:check && npm run audit:prod && npm run stress && npm run test:e2e",
    "prepublishOnly": "npm run package:check"
  },
  "files": [
    "dist",
    "README.md",
    "usage.kdl"
  ],
  "keywords": [
    "gmail",
    "email",
    "mcp",
    "cursor",
    "ai",
    "tui",
    "cli",
    "oauth",
    "model-context-protocol",
    "google-gmail",
    "claude",
    "auto-auth"
  ],
  "author": "George G <11027390+george43g@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/george43g/EQStack.git",
    "directory": "apps/gmail-mcp"
  },
  "bugs": {
    "url": "https://github.com/george43g/EQStack/issues"
  },
  "homepage": "https://github.com/george43g/EQStack/tree/main/apps/gmail-mcp#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "dependencies": {
    "@george43g/robustness": ">=0.9.0 <1",
    "@george43g/tui-kit": ">=0.4.1 <1",
    "@inquirer/prompts": "^8.4.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "email-addresses": "^5.0.0",
    "fuzzysort": "^3.1.0",
    "google-auth-library": "^10.9.0",
    "googleapis": "^173.0.0",
    "ink": "^7.1.1",
    "mime-types": "^3.0.1",
    "nodemailer": "^9.0.3",
    "open": "^10.0.0",
    "picocolors": "^1.1.1",
    "react": "^19.2.6",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.22.1"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^1.3.24",
    "@biomejs/biome": "2.5.9",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.10.5",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.14",
    "@usage-spec/commander": "^1.1.0",
    "ink-testing-library": "^4.0.0",
    "mcp-evals": "^1.0.18",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  }
}
