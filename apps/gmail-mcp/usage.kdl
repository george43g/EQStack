	flag --ids help="Comma-separated message IDs, or '@file.txt' for newline-delimited input" required=#true {
		arg <IDS>
	}
	flag --batch-size help="Per-batch size (default 50)" default="50" {
		arg <BATCH_SIZE>
	}
	flag --json help="Emit typed JSON"
