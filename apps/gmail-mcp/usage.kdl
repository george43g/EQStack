// Generated by scripts/gen-usage.ts — do not edit by hand.
// Run `pnpm run gen-usage` to regenerate after touching the commander tree.

// @generated by @usage-spec/commander from Commander.js metadata
name gmail
bin gmail
version "2.0.0"
about "Gmail — single bin for the Gmail MCP Server package. CLI is the default; subcommands `mcp`, `tui`, `console` expose the server, terminal UI, and interactive REPL respectively. Run `gmail account` to manage authentication."
usage "[options] [command]"
flag "-q --quiet" help="Suppress non-error output to stderr"
flag "-v --verbose" help="Log debug-level information to stderr"
flag "-a --account" help="Gmail account id to use for this command. Overrides GMAIL_ACCOUNT env. See `gmail account list`." {
	arg <ACCOUNT>
}
cmd mcp help="Run the MCP server (stdio by default; --http for remote-mode)" {
	flag --http help="Expose the MCP via Streamable HTTP instead of stdio"
	flag --tool-prefix help="Prefix MCP-advertised tool names (or set GMAIL_MCP_TOOL_PREFIX)" {
		arg <TOOL_PREFIX>
	}
	flag --port help="HTTP port (default: 8080)" default="8080" {
		arg <PORT>
	}
	flag --bind help="HTTP bind address (default: 127.0.0.1; set 0.0.0.0 for direct internet — use a reverse proxy instead)" default="127.0.0.1" {
		arg <BIND>
	}
	flag --token-env help="Name of env var holding the bearer token (default: GMAIL_HTTP_TOKEN). Server refuses to start if unset." default=GMAIL_HTTP_TOKEN {
		arg <TOKEN_ENV>
	}
}
cmd tui help="Launch the multi-pane terminal UI"
cmd console help="Launch an interactive REPL with Gmail ops and account switching"
cmd account help="Manage Gmail accounts, credentials, and OAuth auth" {
	cmd list help="List configured accounts in the manifest" {
		flag --json help="Emit JSON instead of the table"
	}
	cmd current help="Print the active account and how it was resolved" {
		flag --json help="Emit JSON"
	}
	cmd use help="Set the default account used when --account / GMAIL_ACCOUNT is not supplied" {
		arg <id> help="Account id to make default"
	}
	cmd rm help="Remove an account: deletes its credentials directory and manifest entry" {
		flag --force help="Skip the confirmation prompt"
		flag --keep-files help="Remove from manifest only; leave the on-disk directory in place"
		arg <id> help="Account id to remove"
	}
	cmd auth help="Authenticate or re-authenticate a Gmail account" {
		flag "-s --scopes" help="Comma- or space-separated Gmail scopes" {
			arg <SCOPES>
		}
		flag --non-interactive help="Skip the scope-selection prompt"
		flag --headless help="Don't launch a browser; print the consent URL only"
		flag --callback help="OAuth callback URL" {
			arg <CALLBACK>
		}
		flag --port help="Port for the local OAuth callback server" {
			arg <PORT>
		}
		flag --oauth-path help="Path to gcp-oauth.keys.json (default: ~/.gmail-mcp/gcp-oauth.keys.json, or GMAIL_OAUTH_PATH env)" {
			arg <OAUTH_PATH>
		}
		flag --credentials-path help="Where to save credentials (default: account-specific path)" {
			arg <CREDENTIALS_PATH>
		}
		flag --print-json help="Emit credentials JSON to stdout instead of writing files"
		arg "[id]" help="Account id to authenticate (e.g. 'work', 'personal')" required=#false
	}
	cmd check help="Check auth health for one account or all accounts" {
		flag --all help="Check every configured account"
		flag --json help="Emit JSON"
		arg "[id]" help="Account id to check" required=#false
	}
	cmd rename help="Rename an account id and move its credentials directory" {
		arg <oldId> help="Existing account id"
		arg <newId> help="New account id"
	}
}
cmd auth help="Deprecated. Use `gmail account` instead."
cmd health help="Run the health_check canary (no Gmail API calls)" {
	flag --json help="Output JSON instead of human-readable text"
}
cmd inbox help="Shortcut: list recent inbox threads (alias for `threads list -q in:inbox`)" {
	flag "-n --max" help="Max threads — 0 = stream all up to 5000 (default: 10)" {
		arg <MAX>
	}
	flag --all help="Stream every page (shorthand for max = 0)"
	flag --json help="Emit typed JSON"
	arg "[max]" help="Max threads — 0 = stream all up to 5000 (default: 10)" required=#false
}
cmd unread help="Summarise unread mail across all configured accounts (read-only)" {
	flag --samples help="Include up to 5 sample unread inbox subjects per account"
	flag --json help="Emit typed JSON"
}
cmd search help="Search emails (Gmail query syntax — e.g. 'from:foo newer_than:7d')" {
	flag "-n --max" help="Max results — 0 = stream all pages up to 5000 (default: 25)" default="25" {
		arg <MAX>
	}
	flag --all help="Stream every page (shorthand for --max 0)"
	flag --json help="Emit typed JSON instead of human text"
	arg <query> help="Gmail search query"
}
cmd read help="Read an email by message ID" {
	flag --json help="Emit typed JSON instead of human text"
	arg <messageId> help="Gmail message ID"
}
cmd threads subcommand_required=#true help="Thread-level operations (groups of related messages)" {
	cmd list help="List inbox threads (Gmail query syntax via --query)" {
		flag "-q --query" help="Gmail search query (default: in:inbox)" {
			arg <QUERY>
		}
		flag "-n --max" help="Max results — 0 = stream all pages up to 5000 (default: 25)" default="25" {
			arg <MAX>
		}
		flag --all help="Stream every page (shorthand for --max 0)"
		flag --json help="Emit typed JSON"
	}
	cmd get help="Fetch a thread's messages (by thread id, or -m <messageId>)" {
		flag "-m --message-id" help="Resolve the thread from a message id instead of a thread id" {
			arg <MESSAGE_ID>
		}
		flag "-f --format" help="full | metadata | minimal (default: full)" default=full {
			arg <FORMAT>
		}
		flag --json help="Emit typed JSON"
		arg "[threadId]" required=#false
	}
	cmd modify help="Add/remove labels on every message in a thread" {
		flag --add help="Comma-separated label IDs to add" {
			arg <ADD>
		}
		flag --remove help="Comma-separated label IDs to remove" {
			arg <REMOVE>
		}
		flag --json help="Emit typed JSON"
		arg <threadId>
	}
	cmd inbox help="Get inbox threads with optional message-body expansion" {
		flag "-q --query" help="Gmail search query (default: in:inbox)" {
			arg <QUERY>
		}
		flag "-n --max" help="Max threads (default: 25)" default="25" {
			arg <MAX>
		}
		flag "-e --expand" help="Expand each thread with full message content"
		flag --json help="Emit typed JSON"
	}
}
cmd send help="Send an email" {
	flag "-t --to" help="Comma-separated recipients" required=#true {
		arg <TO>
	}
	flag "-s --subject" help="Subject line" required=#true {
		arg <SUBJECT>
	}
	flag "-b --body" help="Body. Literal text, '-' for stdin, or '@path/to/file' to read from disk." {
		arg <BODY>
	}
	flag --html help="HTML body (separate from --body / used for multipart)" {
		arg <HTML>
	}
	flag --cc help="Comma-separated CC" {
		arg <CC>
	}
	flag --bcc help="Comma-separated BCC" {
		arg <BCC>
	}
	flag --attach help="Attach a file (repeatable)" default="" {
		arg <ATTACH>
	}
	flag --inline-image help="Embed a CID image (repeatable); JSON form also supports base64 content" default="" {
		arg <INLINE_IMAGE>
	}
	flag --thread-id help="Reply within this thread" {
		arg <THREAD_ID>
	}
	flag --in-reply-to help="RFC822 Message-ID being replied to" {
		arg <IN_REPLY_TO>
	}
	flag --from help="Send-as alias (must be configured in Gmail)" {
		arg <FROM>
	}
	flag --mime-type help="text/plain | text/html | multipart/alternative (default: text/plain)" {
		arg <MIME_TYPE>
	}
	flag --json help="Emit typed JSON instead of human text"
}
cmd reply-all help="Reply-all to an existing message (auto-builds To/CC and threading headers)" {
	flag "-b --body" help="Body. Literal text, '-' for stdin, or '@path/to/file' to read from disk." {
		arg <BODY>
	}
	flag --html help="HTML body" {
		arg <HTML>
