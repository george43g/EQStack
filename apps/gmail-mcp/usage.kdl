cmd labels subcommand_required=#true help="Manage Gmail labels" {
	cmd list help="List all available labels (system + user)" {
		flag --json help="Emit typed JSON"
	}
	cmd create help="Create a new user label" {
		flag --show help="messageListVisibility=show (default: hide)"
		flag --label-list help="labelListVisibility (labelShow / labelShowIfUnread / labelHide)" {
			arg <LABEL_LIST>
		}
		flag --json help="Emit typed JSON"
		arg <name> help="Label name"
	}
	cmd update help="Update an existing label" {
		flag --name help="New name" {
			arg <NAME>
		}
		flag --show help="messageListVisibility=show"
		flag --hide help="messageListVisibility=hide"
		flag --label-list help=labelListVisibility {
			arg <LABEL_LIST>
		}
		flag --json help="Emit typed JSON"
		arg <id>
	}
	cmd delete help="Delete a label (irreversible)" {
		flag --json help="Emit typed JSON"
		arg <id>
	}
	cmd get-or-create help="Get an existing label by name, or create it" {
		flag --json help="Emit typed JSON"
		arg <name>
	}
}
cmd filters subcommand_required=#true help="Manage Gmail filters (server-side rules)" {
	cmd list help="List all filters" {
		flag --json help="Emit typed JSON"
	}
	cmd get help="Get a single filter by ID" {
		flag --json help="Emit typed JSON"
		arg <filterId>
	}
	cmd create help="Create a custom filter from inline criteria + actions" {
		flag --from help="Match sender" {
			arg <FROM>
		}
		flag --to help="Match recipient" {
			arg <TO>
		}
		flag --subject help="Match subject" {
			arg <SUBJECT>
		}
		flag --query help="Gmail search query" {
			arg <QUERY>
		}
		flag --has-attachment help="Match emails with attachments"
		flag --add-label help="Comma-separated label IDs to add" {
			arg <ADD_LABEL>
		}
		flag --remove-label help="Comma-separated label IDs to remove" {
			arg <REMOVE_LABEL>
		}
		flag --forward help="Forward matches to this address" {
			arg <FORWARD>
		}
		flag --json help="Emit typed JSON"
	}
	cmd delete help="Delete a filter" {
		flag --json help="Emit typed JSON"
		arg <filterId>
	}
	cmd template help="Create a filter from a predefined template (fromSender / withSubject / withAttachments / largeEmails / containingText / mailingList)" {
		flag --sender help="fromSender: sender email" {
			arg <SENDER>
		}
		flag --subject help="withSubject: subject text" {
			arg <SUBJECT>
		}
		flag --text help="containingText: search text" {
			arg <TEXT>
		}
		flag --list-id help="mailingList: identifier" {
			arg <LIST_ID>
		}
		flag --size help="largeEmails: size in bytes" {
			arg <SIZE>
		}
		flag --label help="Comma-separated label IDs to apply" {
			arg <LABEL>
		}
		flag --archive help="Archive matches (skip inbox)"
		flag --mark-read help="Mark matches as read (withSubject only)"
		flag --mark-important help="Mark matches as important (containingText only)"
		flag --json help="Emit typed JSON"
		arg <template>
	}
}
cmd identities help="List send-as identities, forwarding addresses, and routing filters" {
	flag --json help="Emit typed JSON"
}
cmd download-email help="Download an email to disk (json / eml / txt / html)" {
	flag "-o --save-path" help="Directory to save the file in" required=#true {
		arg <SAVE_PATH>
	}
	flag "-f --format" help="json | eml | txt | html (default: json)" default=json {
		arg <FORMAT>
	}
	flag --json help="Emit typed JSON"
	arg <messageId> help="Gmail message ID"
}
cmd download-attachment help="Download an attachment to disk" {
	flag "-o --save-path" help="Directory to save into (default: cwd)" {
		arg <SAVE_PATH>
	}
	flag --filename help="Override the saved filename" {
		arg <FILENAME>
	}
	flag --json help="Emit typed JSON"
	arg <messageId> help="Gmail message ID"
	arg <attachmentId> help="Attachment ID (from read_email output)"
}
