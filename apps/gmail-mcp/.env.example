# Gmail-MCP-Server environment variables
#
# Copy to .env or .env.local and edit. .env.local takes precedence.
# Both files are gitignored.
#
# Loading: package.json scripts and the dev MCP proxy pass --env-file-if-exists
# to Node so these files are loaded automatically. Requires Node >=20.6.

# ---------- Gmail-specific ----------
# Override the config directory (default ~/.gmail-mcp/). Useful in Docker
# (mount a volume here) or for shared deployments. Affects defaults of
# GMAIL_OAUTH_PATH and GMAIL_CREDENTIALS_PATH only — explicit env-inline
# overrides below win.
# GMAIL_CONFIG_DIR=/var/lib/gmail-mcp

# --- OAuth client keys (Google Cloud Console JSON) ---
# Two ways to provide:
# (a) inline JSON in env — wins, lets you run with no filesystem state:
# GMAIL_OAUTH_KEYS_JSON='{"installed":{"client_id":"...","client_secret":"..."}}'
# (b) file path (default ~/.gmail-mcp/gcp-oauth.keys.json):
# GMAIL_OAUTH_PATH=

# --- Stored access/refresh tokens (from `gmail account auth`) ---
# Three ways, first hit wins (see src/core/credentials.ts):
# (a) inline JSON in env — best for GH Actions secrets, Docker, k8s:
# GMAIL_CREDENTIALS_JSON='{"tokens":{...},"scopes":[...]}'
# (b) 1Password reference — shells out to `op read`, no npm dep:
# GMAIL_CREDENTIALS_OP=op://Personal/gmail-mcp/credentials
# (c) explicit file path override. Named accounts otherwise use ~/.gmail-mcp/accounts/<id>/credentials.json:
# GMAIL_CREDENTIALS_PATH=

# Tip: capture (a) for both keys + tokens in one shot:
#   gmail account auth deploy --print-json
# Outputs {GMAIL_OAUTH_KEYS_JSON, GMAIL_CREDENTIALS_JSON} ready to paste into
# a host config env block, GH Actions secret, or 1Password item.

# OAuth scopes for `gmail account auth`. Comma- or space-separated shorthand names.
# Overridden by --scopes=. If unset and stdin is a TTY, you get an interactive
# checkbox prompt; otherwise falls back to defaults (gmail.modify, gmail.settings.basic).
# Available: gmail.readonly, gmail.modify, gmail.compose, gmail.send,
#            gmail.labels, gmail.settings.basic, gmail.settings.sharing
# GMAIL_SCOPES=gmail.modify,gmail.compose,gmail.settings.basic

# Force non-interactive auth (also auto-detected when CI=true or stdin is not a TTY).
# GMAIL_AUTH_NON_INTERACTIVE=1

# --- HTTP transport (Phase G — `gmail-cli serve --http`) ---
# Bearer token gating POST /mcp. Server refuses to start if --http is set but
# this is empty. Generate with: openssl rand -hex 32
# GMAIL_HTTP_TOKEN=

# ---------- Robustness harness (MCP_*) ----------
# These are read by the reusable robustness library. All have sensible defaults.

# Logger
# MCP_LOG_DIR=                     # default: $TMPDIR/gmail-mcp/
# MCP_LOG_MAX_BYTES=10485760       # rotate file at 10MB

# Watchdog — event loop
# MCP_EVENT_LOOP_WARN_MS=500
# MCP_EVENT_LOOP_KILL_MS=10000
# MCP_EVENT_LOOP_SAMPLE_MS=5000

# Watchdog — memory
# MCP_MAX_RSS_MB=1024
# MCP_HEAP_GROWTH_SAMPLES=10
# MCP_MEMORY_SAMPLE_MS=60000

# Watchdog — idle restart
# MCP_RESTART_AFTER_MS=86400000    # 24h
# MCP_RESTART_QUIET_MS=3600000     # 1h
# MCP_IDLE_CHECK_MS=600000         # 10min

# Per-tool timeout default (override per-tool inside src/index.ts)
# MCP_TOOL_TIMEOUT_DEFAULT_MS=30000

# Rate limiter (token bucket — Step 15)
# MCP_RATE_LIMIT_RPS=10
# MCP_RATE_LIMIT_BURST=30

# Retry policy (Step 14)
# MCP_RETRY_MAX_ATTEMPTS=3
# MCP_RETRY_BASE_MS=500
# MCP_RETRY_CAP_MS=8000
