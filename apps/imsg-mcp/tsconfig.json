{
  "extends": "@eqstack/tsconfig/react.json",
  "compilerOptions": {
    // Deferred strictness (docs/STATUS.md backlog "tsconfig strict flags"):
    // enabling these two adds ~155 errors as of 2026-08-03 — their own cycle.
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    // Ink renders to the terminal — no DOM. The react preset's DOM lib also
    // conflicts with @types/node 24 (Buffer vs BlobPart).
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
