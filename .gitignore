# Dependencies
node_modules/

# Build output
dist/
.turbo/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test coverage
coverage/

# Environment files (machine-specific paths and secrets)
.env
.env.local
.env*.local
.env.ai

# Local dev configurations — user-specific paths
# (.mcp.json is TRACKED: its paths are repo-relative, resolved from the repo
#  root, which is the cwd MCP hosts spawn project-scoped servers with.)
.cursor/
.warp/
# .codex/config.toml is tracked for Codex parity: generated by mcpsync from .mcp.json
# (${VAR} references only, never values). Everything else in .codex/ stays local.
.codex/*
!.codex/config.toml
opencode.json
# .agents/ is per-machine, except the repo's own skills (tracked; see repo-scoped-skills).
.agents/*
!.agents/skills/

# Generated synthetic test fixtures (regenerated via `pnpm fixtures`)
fixtures/
fixtures-stress/

# Live (real, PII-bearing) snapshots — never commit, never ship
env-data/

# Temporary files
*.tmp
*.temp
.cache/

# npm pack output / semantic-release tarball staging
*.tgz
release/

# Stress harness output (uploaded as a CI artefact, not committed)
stress-tui-report.json
stress-mcp-report.json
.claude/scheduled_tasks.lock
